# Values for a container behind a reverse proxy.
# The public host is not decided. design.ragil.work is only an example.
# The name and the logo come from brand/brand.config.json. The image build
# runs `bun run apply-brand` before it builds the client.

BETTER_AUTH_URL=https://design.ragil.work
BETTER_AUTH_SECRET=

# Unset, the server uses the sender in brand/brand.config.json
# (currently "Design <no-reply@localhost>").
EMAIL_FROM="Design <no-reply@design.ragil.work>"

# Cloudflare Turnstile on sign-in, sign-up and password reset. Both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
